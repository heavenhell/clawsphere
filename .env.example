DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_MODEL=deepseek-v4-flash
# HTTP(S) 代理开关：true=走代理 / false=直连（默认 false，显式控制，换环境行为可预期）。
DEEPSEEK_PROXY_ENABLED=false
# 代理地址，仅在 DEEPSEEK_PROXY_ENABLED=true 时生效；带账号密码格式：http://user:pass@host:port
DEEPSEEK_PROXY=
# 证书校验开关，默认 true。请求里带着 API key，关闭校验等于把凭据暴露给中间人，
# 只有公司代理用自签名证书做 TLS 终止时才显式设为 false。
DEEPSEEK_VERIFY_SSL=true
DCS_LLM_SEMANTIC_COMPRESSION=true
DCS_LLM_COMPRESSOR_URL=http://127.0.0.1:11434/api/chat
DCS_LLM_COMPRESSOR_MODEL=qwen3.5:4b-q4_K_M
DEMO_MODE=true
DCS_JWT_SECRET=replace-with-a-long-random-secret
# Agent/MCP Server 共用的独立委托签名密钥，生产环境至少 32 字符。
DCS_MCP_DELEGATION_SECRET=replace-with-another-long-random-secret
DCS_ALLOW_ANONYMOUS=true
DCS_CORS_ORIGINS=http://127.0.0.1:5174,http://localhost:5174
DCS_CHAT_RATE_PER_MINUTE=30
DCS_CHAT_BURST_PER_10S=8
DCS_CHAT_MAX_CONCURRENT_PER_USER=2
DCS_CHAT_MAX_CONCURRENT_GLOBAL=8
MCP_AUTH_TOKEN=
MCP_CALLER_USER_ID=mcp-demo-user
MCP_CALLER_ROLES=readonly
MCP_CALLER_TENANT_ID=demo-tenant
POSTGRES_DSN=postgresql://clawsphere:clawsphere-local@127.0.0.1:54329/clawsphere
DCS_DATA_DIR=./data
DCS_MEMORY_BACKEND=sqlite
DCS_CHECKPOINT_BACKEND=sqlite
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://127.0.0.1:3000
LANGFUSE_TRACING_ENVIRONMENT=development
