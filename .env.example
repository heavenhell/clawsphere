DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_MODEL=deepseek-chat
DEMO_MODE=true
DCS_JWT_SECRET=replace-with-a-long-random-secret
DCS_ALLOW_ANONYMOUS=true
DCS_CORS_ORIGINS=http://127.0.0.1:5174,http://localhost:5174
MCP_TRANSPORT=stdio
MCP_AUTH_TOKEN=
MCP_CALLER_USER_ID=mcp-demo-user
MCP_CALLER_ROLES=readonly
MCP_CALLER_TENANT_ID=demo-tenant
POSTGRES_DSN=postgresql://clawsphere:clawsphere-local@127.0.0.1:54329/clawsphere
DCS_DATA_DIR=./data
DCS_MEMORY_BACKEND=sqlite
DCS_CHECKPOINT_BACKEND=sqlite
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://127.0.0.1:3000
LANGFUSE_TRACING_ENVIRONMENT=development
